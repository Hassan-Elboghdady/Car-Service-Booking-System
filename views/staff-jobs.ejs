<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>My Jobs  AutoServe Staff</title>
<link rel="stylesheet" href="../public/Css/shared.css"/></head>
<body>
<div class="sidebar-overlay" id="sidebar-overlay"></div>
<div class="app-layout">
<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand" style="display:flex;align-items:center;">
    <img src="/public/LogoBrand/AutoServeLogo.jpg" alt="AutoServe" style="height:36px; border-radius:6px; margin-right:10px;">
    <div class="name" style="font-weight:800;font-size:1.4rem;color:var(--text);margin-right:auto;">Auto<span style="color:var(--primary)">Serve</span></div>
    <div class="role-tag">Staff Panel</div>
  </div>
  <div class="sidebar-section">My Work</div>
  <nav class="sidebar-nav">
    <a href="staff-dashboard.ejs"><span class="s-icon">📊</span> Dashboard</a>
    <a href="staff-jobs.ejs" class="active"><span class="s-icon">🧰</span> My Jobs</a>
    <a href="staff-schedule.ejs"><span class="s-icon">📅</span> Schedule</a>
  </nav>
  <div class="sidebar-section">Service</div>
  <nav class="sidebar-nav">
    <a href="staff-issues.ejs"><span class="s-icon">📝</span> Report Issue</a>
  </nav>
  <div class="sidebar-section">Account</div>
  <nav class="sidebar-nav">
    <a href="profile.ejs"><span class="s-icon">👤</span> Profile</a>
    <a href="index.ejs"><span class="s-icon">🏠</span> Main Site</a>
    <a href="#" onclick="doLogout()"><span class="s-icon">🚪</span> Logout</a>
  </nav>
</aside>
<div class="main-content">
  <div class="main-header">
    <div class="flex-gap"><button id="sidebar-toggle" class="btn btn-ghost btn-sm btn-icon">☰</button><span class="main-title">Jobs</span></div>
  </div>
  <div class="content-area">

    
    <div style="display:flex;gap:0;border-radius:var(--radius-md);overflow:hidden;border:1px solid var(--gray-200);width:fit-content;margin-bottom:24px">
      <button class="btn btn-primary" data-jtab="mine" style="border-radius:0;border:none"> My Jobs</button>
      <button class="btn btn-ghost" data-jtab="available" style="border-radius:0;border:none;border-left:1px solid var(--gray-200)"> Available Jobs</button>
    </div>

    
    <div class="tabs mb-24" id="status-filters">
      <button class="tab-btn active" data-jf="all">All</button>
      <button class="tab-btn" data-jf="pending">Pending</button>
      <button class="tab-btn" data-jf="in_progress">In Progress</button>
      <button class="tab-btn" data-jf="completed">Completed</button>
    </div>

    <div id="jobs-grid"></div>
  </div>
</div>
</div>
<div id="toast-root"></div>
<script src="../public/Js/shared.js?v=5"></script>
<script src="../public/Js/staff-jobs.js?v=5"></script>
</body>
</html>

