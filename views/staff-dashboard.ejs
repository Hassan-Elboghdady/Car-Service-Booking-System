<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Staff Dashboard  AutoServe</title>
<link rel="stylesheet" href="../public/Css/shared.css"/>
<link rel="stylesheet" href="../public/Css/staff-dashboard.css"/>
</head>
<body>
<div class="sidebar-overlay" id="sidebar-overlay"></div>
<div class="app-layout">
<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand" style="display:flex;align-items:center;">
    <img src="/public/LogoBrand/AutoServeLogo.jpg" alt="AutoServe" style="height:36px; border-radius:6px; margin-right:10px;">
    <div class="name" style="font-weight:800;font-size:1.4rem;color:var(--text);margin-right:auto;">Auto<span style="color:var(--primary)">Serve</span></div>
    <div class="role-tag">Staff Panel</div>
  </div>
  <div class="sidebar-section">My Work</div>
  <nav class="sidebar-nav">
    <a href="staff-dashboard.ejs" class="active"><span class="s-icon">📊</span> Dashboard</a>
    <a href="staff-jobs.ejs"><span class="s-icon">🧰</span> My Jobs</a>
    <a href="staff-schedule.ejs"><span class="s-icon">📅</span> Schedule</a>
  </nav>
  <div class="sidebar-section">Service</div>
  <nav class="sidebar-nav">
    <a href="staff-issues.ejs"><span class="s-icon">📝</span> Report Issue</a>
  </nav>
  <div class="sidebar-section">Account</div>
  <nav class="sidebar-nav">
    <a href="profile.ejs"><span class="s-icon">👤</span> Profile</a>
    <a href="index.ejs"><span class="s-icon">🏠</span> Main Site</a>
    <a href="#" onclick="doLogout()"><span class="s-icon">🚪</span> Logout</a>
  </nav>
  <div id="mgr-sidebar-stats" style="display:none;margin:16px;padding:16px;background:rgba(230,0,35,.08);border-radius:var(--radius-md);border:1px solid rgba(230,0,35,.18)">
    <div style="font-size:.7rem;font-weight:700;color:var(--primary);text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px"> Revenue Today</div>
    <div id="mgr-rev-today" style="font-size:1.2rem;font-weight:800;color:var(--primary)">EGP </div>
    <div style="font-size:.7rem;color:var(--gray-400);margin-top:2px" id="mgr-rev-today-label"></div>
    <div style="margin-top:12px;padding-top:12px;border-top:1px solid rgba(230,0,35,.15)">
      <div style="font-size:.7rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;margin-bottom:8px">This Month</div>
      <div id="mgr-rev-month" style="font-size:1rem;font-weight:700;color:var(--gray-700)">EGP </div>
    </div>
    <div style="margin-top:10px;display:flex;gap:8px">
      <div style="flex:1;background:rgba(0,0,0,.04);border-radius:6px;padding:8px;text-align:center">
        <div id="mgr-pending-count" style="font-weight:800;font-size:1rem"></div>
        <div style="font-size:.65rem;color:var(--gray-400)">Pending</div>
      </div>
      <div style="flex:1;background:rgba(0,0,0,.04);border-radius:6px;padding:8px;text-align:center">
        <div id="mgr-done-count" style="font-weight:800;font-size:1rem;color:var(--success)"></div>
        <div style="font-size:.65rem;color:var(--gray-400)">Done</div>
      </div>
    </div>
  </div>
</aside>
<div class="main-content">
  <div class="main-header">
    <div class="flex-gap"><button id="sidebar-toggle" class="btn btn-ghost btn-sm btn-icon">☰</button><span class="main-title">Staff Dashboard</span></div>
    <div class="nav-avatar" id="staff-avatar">S</div>
  </div>
  <div class="content-area">
    <div class="flex-between flex-wrap mb-28" style="gap:12px">
      <div>
        <h2 style="margin-bottom:6px; display: inline-flex; align-items: center; gap: 8px;">Welcome back, <span id="staff-name">Staff</span><span id="staff-welcome-icon" style="display: inline-flex; align-items: center;"></span></h2>
        <div id="staff-role-tag"></div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:20px;margin-bottom:28px" id="staff-stats"></div>

    <div style="display:grid;grid-template-columns:1fr 300px;gap:24px" id="mechanic-layout">
      <div class="card">
        <div class="card-header flex-between">
          <h3>My Assigned Jobs</h3>
          <a href="staff-jobs.ejs" class="btn btn-ghost btn-sm">View All</a>
        </div>
        <div id="staff-jobs-list" style="padding:0 24px 24px"></div>
      </div>
      <div class="card card-body">
        <h4 style="margin-bottom:14px"> My Today's Schedule</h4>
        <div id="today-schedule"></div>
      </div>
    </div>

    <div id="staff-main-layout"></div>
  </div>
</div>
</div>
<div id="toast-root"></div>
<script src="../public/Js/shared.js?v=6"></script>
<script src="../public/Js/staff-dashboard.js?v=6"></script>
</body>
</html>

