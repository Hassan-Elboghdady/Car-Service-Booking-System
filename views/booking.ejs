<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Book a Service  AutoServe</title>
  <meta name="description" content="Book your car service in 4 easy steps. Choose vehicle, service, date & confirm."/>
  <link rel="stylesheet" href="../public/Css/shared.css"/>
  <link rel="stylesheet" href="../public/Css/booking.css"/>
</head>
<body>
<div id="navbar-wrap"></div>

<div class="page-header">
  <div class="container">
    <div class="breadcrumb"><a href="index.ejs">Home</a><span class="breadcrumb-sep"></span><span>Booking</span></div>
    <h1>Book a Service</h1>
    <p>Choose your vehicle, select services, pick a date & confirm  done in minutes.</p>
  </div>
</div>

<section class="section-sm">
  <div class="container">
    <div id="booking-auth-guard"></div>
    <div id="booking-wizard" style="display:none">

      <!-- Progress steps -->
      <div class="wizard-steps">
        <div class="wizard-step active" data-step="1"><div class="step-circle">1</div><div class="step-label">Vehicle</div></div>
        <div class="wizard-connector"></div>
        <div class="wizard-step" data-step="2"><div class="step-circle">2</div><div class="step-label">Services</div></div>
        <div class="wizard-connector"></div>
        <div class="wizard-step" data-step="3"><div class="step-circle">3</div><div class="step-label">Date & Time</div></div>
        <div class="wizard-connector"></div>
        <div class="wizard-step" data-step="4"><div class="step-circle">4</div><div class="step-label">Confirm</div></div>
      </div>

      <div class="wizard-layout">
        <div class="wizard-main">

          <!-- Step 1: Vehicle -->
          <div class="wizard-panel active" id="step-1">
            <h3 class="wizard-panel-title">Choose Your Vehicle</h3>
            <div id="step1-cars"></div>
            <button class="btn btn-ghost btn-sm mt-16" onclick="openModal('add-car-from-booking')">+ Add New Vehicle</button>
          </div>

          <!-- Step 2: Services -->
          <div class="wizard-panel" id="step-2">
            <h3 class="wizard-panel-title">Select Services <span style="font-size:.8rem;color:var(--gray-500);font-weight:400">(multi-select  one mileage package)</span></h3>

            <!-- Filter tabs -->
            <div class="svc-filter-bar" id="svc-filter-bar">
              <button class="svc-filter-btn active" data-cat="all"> All</button>
              <button class="svc-filter-btn" data-cat="maintenance"> Maintenance</button>
              <button class="svc-filter-btn" data-cat="cleaning"> Cleaning</button>
              <button class="svc-filter-btn" data-cat="repair"> Repair</button>
              <button class="svc-filter-btn" data-cat="mileage"> Mileage Packages</button>
            </div>

            <!-- Search -->
            <div style="margin:12px 0">
              <input class="form-control" id="svc-search" placeholder="Search services" style="max-width:320px"/>
            </div>

            <!-- Selection count -->
            <div class="flex-between mb-12">
              <span id="svc-selected-count" style="font-size:.85rem;color:var(--gray-500)">No services selected</span>
              <button class="btn btn-ghost btn-sm" onclick="clearServices()" id="clear-svcs-btn" style="display:none">Clear all</button>
            </div>

            <div id="step2-services"></div>
          </div>

          <!-- Step 3: Date & Time -->
          <div class="wizard-panel" id="step-3">
            <h3 class="wizard-panel-title"> Date & Time</h3>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="bk-date">Preferred Date *</label>
                <input class="form-control" type="date" id="bk-date"/>
              </div>
              <div class="form-group">
                <label class="form-label" for="bk-time">Preferred Time *</label>
                <select class="form-control" id="bk-time">
                  <option value="">Choose time</option>
                  <option>08:00 AM</option><option>09:00 AM</option><option>10:00 AM</option>
                  <option>11:00 AM</option><option>12:00 PM</option><option>01:00 PM</option>
                  <option>02:00 PM</option><option>03:00 PM</option><option>04:00 PM</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="bk-notes">Notes for Technician</label>
              <textarea class="form-control" id="bk-notes" rows="3" placeholder="Any additional info for our team"></textarea>
            </div>
            <div class="coupon-row">
              <input class="form-control" id="bk-coupon" placeholder="Coupon code (optional)"/>
              <button class="btn btn-ghost" id="apply-coupon-btn">Apply</button>
            </div>
            <div id="coupon-result"></div>
          </div>

          <!-- Step 4: Confirm -->
          <div class="wizard-panel" id="step-4">
            <h3 class="wizard-panel-title">Review & Confirm</h3>
            <div id="step4-summary" class="booking-summary-box"></div>
            <div class="form-group" style="margin-top:20px;">
              <label class="form-label" for="bk-payment">Payment Method (Pay upon arrival)</label>
              <select class="form-control" id="bk-payment">
                <option value="Cash">Cash</option>
                <option value="Card (Visa/MC)">Card (Visa/MC)</option>
                <option value="Bank Transfer">Bank Transfer</option>
                <option value="InstaPay">InstaPay</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="wizard-sidebar">
          <div class="card card-body">
            <h4 style="margin-bottom:16px">Booking Summary</h4>
            <div id="sidebar-summary">
              <p style="color:var(--gray-400);font-size:.85rem">Your selections will appear here.</p>
            </div>
            <div class="wizard-nav" style="margin-top:24px">
              <button class="btn btn-ghost btn-block" id="prev-btn" style="display:none">← Back</button>
              <button class="btn btn-primary btn-block" id="next-btn">Continue →</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Add car modal -->
<div class="modal-overlay" id="add-car-from-booking">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">Add Vehicle</div>
      <button class="modal-close" onclick="closeModal('add-car-from-booking')">✕</button>
    </div>
    <div class="modal-body">
      <div id="ab-alert"></div>
      <div class="form-group">
        <label class="form-label" for="ab-brand">Car Brand *</label>
        <select class="form-control" id="ab-brand"><option value="">Select brand…</option></select>
      </div>
      <div class="form-group">
        <label class="form-label" for="ab-model">Model *</label>
        <select class="form-control" id="ab-model" disabled><option value="">Select model…</option></select>
      </div>
      <div class="form-group">
        <label class="form-label" for="ab-year">Year *</label>
        <select class="form-control" id="ab-year" disabled><option value="">Select year…</option></select>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="ab-plate-numbers">License Plate *</label>
          <div class="plate-split">
            <input class="form-control plate-input plate-numbers" id="ab-plate-numbers" placeholder="1234" inputmode="numeric" maxlength="4"/>
            <input class="form-control plate-input plate-letters" id="ab-plate-letters" placeholder="أ ب ج" dir="rtl" maxlength="7"/>
            <input type="hidden" id="ab-plate"/>
          </div>
          <div class="form-hint">Numbers (max 4) on the left — Arabic letters (max 3) on the right.</div>
        </div>
        <div class="form-group">
          <label class="form-label" for="ab-color">Color *</label>
          <select class="form-control" id="ab-color">
            <option value="">Select color…</option>
            <option value="Black">Black</option>
            <option value="White">White</option>
            <option value="Silver">Silver</option>
            <option value="Gray">Gray</option>
            <option value="Red">Red</option>
            <option value="Blue">Blue</option>
            <option value="Green">Green</option>
            <option value="Yellow">Yellow</option>
            <option value="Orange">Orange</option>
            <option value="Brown">Brown</option>
            <option value="Beige">Beige</option>
            <option value="Gold">Gold</option>
            <option value="Purple">Purple</option>
            <option value="Other">Other</option>
          </select>
          <div class="form-group" id="ab-color-custom-wrap" style="display:none; margin-top:10px;">
            <input class="form-control" id="ab-color-custom" placeholder="Enter custom color"/>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('add-car-from-booking')">Cancel</button>
      <button class="btn btn-primary" id="ab-save">Add Car</button>
    </div>
  </div>
</div>

<div id="footer-wrap"></div>
<script src="../public/Js/shared.js"></script>
<script src="../public/Js/booking.js"></script>
</body>
</html>

