<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Inventory Management  AutoServe Admin</title>
  <link rel="stylesheet" href="../public/Css/shared.css"/>
  <link rel="stylesheet" href="../public/Css/inventory.css"/>
</head>
<body>
<div class="sidebar-overlay" id="sidebar-overlay"></div>
<div class="app-layout">
<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand"><div class="name">Auto<span>Serve</span></div><div class="role-tag">Admin Panel</div></div>
  <div class="sidebar-section">Overview</div>
  <nav class="sidebar-nav">
    <a href="admin-dashboard.ejs"><span class="s-icon">📊</span> Dashboard</a>
    <a href="booking-management.ejs"><span class="s-icon">📅</span> Bookings</a>
    <a href="admin-services.ejs"><span class="s-icon">🔧</span> Services</a>
  </nav>
  <div class="sidebar-section">Management</div>
  <nav class="sidebar-nav">
    <a href="customer-management.ejs"><span class="s-icon"></span> Customers</a>
    <a href="admin-staff.ejs"><span class="s-icon">👥</span> Staff</a>
    <a href="admin-vehicles.ejs"><span class="s-icon">🚗</span> Vehicles</a>
    <a href="inventory.ejs" class="active"><span class="s-icon">📦</span> Inventory</a>
  </nav>
  <div class="sidebar-section">Analytics</div>
  <nav class="sidebar-nav">
    <a href="revenue-reports.ejs"><span class="s-icon">📈</span> Reports</a>
    <a href="admin-reviews.ejs"><span class="s-icon">⭐</span> Reviews</a>
  </nav>
  <div class="sidebar-section">System</div>
  <nav class="sidebar-nav">
    <a href="admin-notifications.ejs"><span class="s-icon">🔔</span> Notifications</a>
    <a href="admin-cms.ejs"><span class="s-icon">📝</span> CMS</a>
    <a href="admin-settings.ejs"><span class="s-icon">⚙️</span> Settings</a>
    <a href="index.ejs"><span class="s-icon">🏠</span> Main Site</a>
    <a href="#" onclick="doLogout()"><span class="s-icon">🚪</span> Logout</a>
  </nav>
</aside>
<div class="main-content">
  <div class="main-header">
    <div class="flex-gap"><button id="sidebar-toggle" class="btn btn-ghost btn-sm btn-icon">☰</button><span class="main-title">Inventory Stock</span></div>
    <div style="display:flex;gap:12px">
      <input class="form-control" id="inv-search" placeholder="Search items" style="max-width:220px;padding:8px 14px"/>
      <button class="btn btn-primary btn-sm" onclick="openModal('inv-modal')">+ Add Item</button>
    </div>
  </div>
  <div class="content-area">
    <div class="grid-4 mb-28" id="inv-stats"></div>
    <div style="display:grid;grid-template-columns:1fr 340px;gap:24px">
      <div class="card">
        <div class="table-wrap" style="border:none;border-radius:0">
          <table>
            <thead>
              <tr>
                <th>Item</th>
                <th>Category</th>
                <th>In Stock</th>
                <th>Unit</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="inv-tbody"></tbody>
          </table>
        </div>
      </div>
      <div class="card card-body">
        <h4 style="margin-bottom:16px"> Low Stock Alerts</h4>
        <div id="low-stock-list"></div>
        <div class="mt-20">
          <button class="btn btn-outline btn-block btn-sm" onclick="generateOrder()">Request Parts Order</button>
        </div>
      </div>
    </div>
  </div>
</div>
</div>
<div class="modal-overlay" id="inv-modal">
  <div class="modal">
    <div class="modal-header"><div class="modal-title">Inventory Item</div><button class="modal-close" onclick="closeModal('inv-modal')">✕</button></div>
    <div class="modal-body">
      <div class="form-group"><label class="form-label">Item Name *</label><input class="form-control" id="in-name"/></div>
      <div class="form-group">
        <label class="form-label">Category</label>
        <select class="form-control" id="in-cat">
          <option value="Fluids">Fluids (Oil/Coolant)</option>
          <option value="Parts">Spare Parts</option>
          <option value="Cleaning">Cleaning Supplies</option>
          <option value="Tools">Tools/Equipment</option>
        </select>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Quantity</label><input class="form-control" type="number" id="in-qty"/></div>
        <div class="form-group"><label class="form-label">Alert level</label><input class="form-control" type="number" id="in-low"/></div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('inv-modal')">Cancel</button>
      <button class="btn btn-primary" id="in-save">Save Item</button>
    </div>
  </div>
</div>
<div id="toast-root"></div>
<script src="../public/Js/shared.js"></script>
<script src="../public/Js/inventory.js"></script>
</body>
</html>
