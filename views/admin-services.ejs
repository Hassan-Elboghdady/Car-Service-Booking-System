<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Service Management  AutoServe Admin</title>
  <link rel="stylesheet" href="../public/Css/shared.css"/>
  <link rel="stylesheet" href="../public/Css/admin-services.css"/>
</head>
<body>
<div class="sidebar-overlay" id="sidebar-overlay"></div>
<div class="app-layout">
<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand" style="display:flex;align-items:center;">
    <img src="../public/images/LogoBrand/AutoServeLogo.jpg" alt="AutoServe" style="height:36px; border-radius:6px; margin-right:10px;">
    <div class="name" style="font-weight:800;font-size:1.4rem;color:var(--text);margin-right:auto;">Auto<span style="color:var(--primary)">Serve</span></div>
    <div class="role-tag">Admin Panel</div>
  </div>
  <div class="sidebar-section">Overview</div>
  <nav class="sidebar-nav">
    <a href="admin-dashboard.ejs"><span class="s-icon">📊</span> Dashboard</a>
    <a href="admin-bookings.ejs"><span class="s-icon">📅</span> Bookings</a>
    <a href="admin-services.ejs" class="active"><span class="s-icon">🔧</span> Services</a>
  </nav>
  <div class="sidebar-section">Management</div>
  <nav class="sidebar-nav">
    <a href="admin-staff.ejs"><span class="s-icon">👥</span> Staff</a>
    <a href="admin-vehicles.ejs"><span class="s-icon">🚗</span> Vehicles</a>
    <a href="admin-payments.ejs"><span class="s-icon">💳</span> Payments</a>
    <a href="admin-inventory.ejs"><span class="s-icon">📦</span> Inventory</a>
  </nav>
  <div class="sidebar-section">Analytics</div>
  <nav class="sidebar-nav">
    <a href="admin-reports.ejs"><span class="s-icon">📈</span> Reports</a>
    <a href="admin-reviews.ejs"><span class="s-icon">⭐</span> Reviews</a>
  </nav>
  <div class="sidebar-section">System</div>
  <nav class="sidebar-nav">
    <a href="admin-notifications.ejs"><span class="s-icon">🔔</span> Notifications</a>
    <a href="admin-cms.ejs"><span class="s-icon">📝</span> CMS</a>
    <a href="admin-settings.ejs"><span class="s-icon">⚙️</span> Settings</a>
    <a href="index.ejs"><span class="s-icon">🏠</span> Main Site</a>
    <a href="#" onclick="doLogout()"><span class="s-icon">🚪</span> Logout</a>
  </nav>
</aside>

<div class="main-content">
  <div class="main-header">
    <div class="flex-gap"><button id="sidebar-toggle" class="btn btn-ghost btn-sm btn-icon">☰</button><span class="main-title">Service Management</span></div>
    <div class="flex-gap">
      <button class="btn btn-outline btn-sm" onclick="openAddMileageModal()">&#x1F6E3;&#xFE0F; Add Mileage Package</button>
      <button class="btn btn-primary btn-sm" onclick="openModal('svc-modal')">+ Add Service</button>
    </div>
  </div>
  <div class="content-area">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:20px;margin-bottom:28px" id="svc-stats"></div>

    <!-- Filter row -->
    <div class="flex-gap mb-16" style="flex-wrap:wrap">
      <button class="tab-btn active" data-cat="all" onclick="setAdminCat(this,'all')">All Services</button>
      <button class="tab-btn" data-cat="maintenance" onclick="setAdminCat(this,'maintenance')">Maintenance</button>
      <button class="tab-btn" data-cat="cleaning" onclick="setAdminCat(this,'cleaning')">Cleaning</button>
      <button class="tab-btn" data-cat="repair" onclick="setAdminCat(this,'repair')">Repair</button>
      <button class="tab-btn" data-cat="mileage" onclick="setAdminCat(this,'mileage')">&#x1F6E3;&#xFE0F; Mileage Packages</button>
    </div>

    <div id="services-admin-grid"></div>

    <!-- Mileage Packages Section -->
    <div id="mileage-admin-section" style="display:none">
      <div class="card" style="margin-bottom:24px">
        <div class="card-header flex-between">
          <div>
            <h3>&#x1F6E3;&#xFE0F; Mileage Package Pricing</h3>
            <span class="badge badge-blue" id="mileage-badge">10 Packages &middot; 10k &ndash; 100k km</span>
          </div>
          <div style="display:flex;gap:10px;align-items:center">
            <button class="btn btn-primary btn-sm" onclick="openModal('add-mileage-modal')">+ Add Package</button>
            <button class="btn btn-outline btn-sm" onclick="saveMileagePrices()">&#x1F4BE; Save Prices</button>
          </div>
        </div>
        <div class="table-wrap" style="border:none;border-radius:0">
          <table>
            <thead>
              <tr>
                <th>Package</th>
                <th>Duration</th>
                <th>Economy &#x1F7E2;<br><small style="font-weight:400;color:var(--gray-400)">Yaris, Spark, MG3&hellip;</small></th>
                <th>Mid-Range &#x1F535;<br><small style="font-weight:400;color:var(--gray-400)">Corolla, Elantra, MG ZS&hellip;</small></th>
                <th>Premium &#x1F7E3;<br><small style="font-weight:400;color:var(--gray-400)">Land Cruiser, Patrol, MG7&hellip;</small></th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="mileage-admin-tbody"></tbody>
          </table>
        </div>
      </div>

      <!-- Car Tier Manager -->
      <div class="card">
        <div class="card-header flex-between">
          <h3>&#x1F697; Car Tier Manager</h3>
          <button class="btn btn-primary btn-sm" onclick="saveTiers()">&#x1F4BE; Save Tiers</button>
        </div>
        <div class="card-body">
          <p style="font-size:.83rem;color:var(--gray-500);margin-bottom:16px">Assign each car model to Economy, Mid-Range, or Premium. This affects mileage package pricing.</p>
          <div id="tier-manager-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px"></div>
        </div>
      </div>
    </div>
  </div>
</div>
</div>

<!-- Add/Edit Service Modal -->
<div class="modal-overlay" id="svc-modal">
  <div class="modal" style="max-width:620px">
    <div class="modal-header">
      <div class="modal-title" id="svc-modal-title">Add New Service</div>
      <button class="modal-close" onclick="closeModal('svc-modal')">&#x2715;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="svc-edit-id"/>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Service Name *</label>
          <input class="form-control" id="svc-name" placeholder="e.g. Oil Change"/>
        </div>
        <div class="form-group">
          <label class="form-label">Icon/Emoji</label>
          <input class="form-control" id="svc-icon" placeholder="&#x1F6E2;&#xFE0F;" maxlength="4"/>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Category *</label>
          <select class="form-control" id="svc-cat" onchange="toggleMileageFields()">
            <option value="maintenance">Maintenance</option>
            <option value="cleaning">Cleaning</option>
            <option value="repair">Repair</option>
            <option value="mileage">&#x1F6E3;&#xFE0F; Mileage Package</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Duration</label>
          <input class="form-control" id="svc-dur" placeholder="e.g. 1h"/>
        </div>
      </div>

      <!-- Standard price (hidden for mileage) -->
      <div class="form-group" id="svc-price-group">
        <label class="form-label">Price (EGP) *</label>
        <input class="form-control" id="svc-price" type="number" min="0" placeholder="299"/>
      </div>

      <!-- Mileage-only fields -->
      <div id="svc-mileage-fields" style="display:none">
        <div class="form-group" id="svc-mileage-km">
          <label class="form-label" for="svc-km">Km Milestone *</label>
          <input class="form-control" id="svc-km" type="number" min="1000" step="1000" placeholder="e.g. 120000"/>
          <div class="form-hint">Enter the km milestone for this package (e.g. 120000 for a 120k service)</div>
        </div>
        <div class="form-group">
          <label class="form-label" for="svc-includes">What's Included (one per line)</label>
          <textarea class="form-control" id="svc-includes" rows="3" placeholder="Engine oil change&#10;Oil filter replacement&#10;Tyre rotation"></textarea>
        </div>
        <div style="background:var(--gray-50);border:1px solid var(--gray-200);border-radius:var(--radius-sm);padding:16px;margin-bottom:16px">
          <div style="font-size:.83rem;font-weight:700;color:var(--gray-600);margin-bottom:10px">Price by Car Tier (EGP)</div>
          <div class="form-row">
            <div class="form-group" style="margin-bottom:0">
              <label class="form-label" style="color:#15803d">&#x1F7E2; Economy</label>
              <input class="form-control" id="svc-price-eco" type="number" min="0" placeholder="e.g. 550"/>
            </div>
            <div class="form-group" style="margin-bottom:0">
              <label class="form-label" style="color:#1d4ed8">&#x1F535; Mid-Range</label>
              <input class="form-control" id="svc-price-mid" type="number" min="0" placeholder="e.g. 750"/>
            </div>
          </div>
          <div class="form-group" style="margin-top:12px;margin-bottom:0">
            <label class="form-label" style="color:#7c3aed">&#x1F7E3; Premium</label>
            <input class="form-control" id="svc-price-prem" type="number" min="0" placeholder="e.g. 1100"/>
          </div>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Description</label>
        <textarea class="form-control" id="svc-desc" rows="3" placeholder="Service description&hellip;"></textarea>
      </div>
      <div class="form-group">
        <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
          <input type="checkbox" id="svc-popular" style="accent-color:var(--primary);width:16px;height:16px"/>
          Mark as Popular (shows on home page)
        </label>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('svc-modal')">Cancel</button>
      <button class="btn btn-primary" id="svc-save-btn">Save Service</button>
    </div>
  </div>
</div>

<!-- Add Mileage Package Modal -->
<div class="modal-overlay" id="add-mileage-modal">
  <div class="modal" style="max-width:500px">
    <div class="modal-header">
      <div class="modal-title">&#x1F6E3;&#xFE0F; Add Mileage Package</div>
      <button class="modal-close" onclick="closeModal('add-mileage-modal')">&#x2715;</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">Package Name *</label>
        <input class="form-control" id="mp-name" placeholder="e.g. 120,000 km Service"/>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Mileage (km) *</label>
          <input class="form-control" id="mp-km" type="number" min="1000" step="1000" placeholder="120000"/>
        </div>
        <div class="form-group">
          <label class="form-label">Duration *</label>
          <input class="form-control" id="mp-dur" placeholder="e.g. 8h"/>
        </div>
      </div>
      <div style="background:var(--gray-50);border:1px solid var(--gray-200);border-radius:var(--radius-sm);padding:16px;margin-bottom:16px">
        <div style="font-size:.83rem;font-weight:700;color:var(--gray-600);margin-bottom:10px">Price by Car Tier (EGP)</div>
        <div class="form-row">
          <div class="form-group" style="margin-bottom:0">
            <label class="form-label" style="color:#15803d">&#x1F7E2; Economy</label>
            <input class="form-control" id="mp-eco" type="number" min="0" placeholder="550"/>
          </div>
          <div class="form-group" style="margin-bottom:0">
            <label class="form-label" style="color:#1d4ed8">&#x1F535; Mid-Range</label>
            <input class="form-control" id="mp-mid" type="number" min="0" placeholder="750"/>
          </div>
        </div>
        <div class="form-group" style="margin-top:12px;margin-bottom:0">
          <label class="form-label" style="color:#7c3aed">&#x1F7E3; Premium</label>
          <input class="form-control" id="mp-prem" type="number" min="0" placeholder="1100"/>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Description</label>
        <textarea class="form-control" id="mp-desc" rows="2" placeholder="Brief description of the package"></textarea>
      </div>
      <div class="form-group">
        <label class="form-label">What&rsquo;s Included (one per line)</label>
        <textarea class="form-control" id="mp-includes" rows="3" placeholder="Engine oil change&#10;Oil filter replacement&#10;Tyre rotation"></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('add-mileage-modal')">Cancel</button>
      <button class="btn btn-primary" onclick="addMileagePackage()">Add Package</button>
    </div>
  </div>
</div>

<div id="toast-root"></div>
<script src="../public/Js/shared.js"></script>
<script src="../public/Js/admin-services.js"></script>
</body>
</html>

