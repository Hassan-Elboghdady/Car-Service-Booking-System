<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Loyalty Rewards  AutoServe</title>
  <meta name="description" content="Earn and redeem loyalty points for free car services and exclusive perks."/>
  <link rel="stylesheet" href="../public/Css/shared.css"/>
  <style>
    .tier-card { border-radius:var(--radius-md); padding:24px; text-align:center; border:2px solid var(--gray-200); transition:var(--transition); }
    .tier-card.active-tier { border-color:var(--primary); box-shadow:var(--shadow-red); }
    .tier-badge { width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.8rem;margin:0 auto 12px; }
    .how-step { display:flex;align-items:flex-start;gap:16px;padding:16px 0;border-bottom:1px solid var(--gray-100); }
    .how-step:last-child{border:none}
    .how-step-num{width:36px;height:36px;border-radius:50%;background:var(--primary);color:white;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.88rem}
  </style>
</head>
<body>
<div id="navbar-wrap"></div>

<div class="page-header">
  <div class="container">
    <div class="breadcrumb"><a href="index.ejs">Home</a><span class="breadcrumb-sep"></span><span>Rewards</span></div>
    <h1>Loyalty Rewards </h1>
    <p>Earn points with every service and redeem them for exclusive rewards.</p>
  </div>
</div>

<section class="section">
  <div class="container">

    <!-- POINTS BANNER -->
    <div class="points-banner mb-32">
      <div>
        <div style="font-size:.85rem;opacity:.8;margin-bottom:6px;text-transform:uppercase;letter-spacing:1px">Your Balance</div>
        <div class="points-num" id="points-display">0</div>
        <div style="opacity:.75;margin-top:6px">loyalty points</div>
        <div style="display:flex;gap:12px;margin-top:20px;flex-wrap:wrap">
          <div style="background:rgba(255,255,255,.2);border-radius:10px;padding:10px 16px;font-size:.85rem">
            <strong id="tier-name">Bronze Tier</strong><br>
            <span style="font-size:.75rem;opacity:.8" id="tier-progress-text">0 pts to next tier</span>
          </div>
          <div style="background:rgba(255,255,255,.2);border-radius:10px;padding:10px 16px;font-size:.85rem">
            <strong id="pts-to-next"></strong><br>
            <span style="font-size:.75rem;opacity:.8">points to next tier</span>
          </div>
        </div>
      </div>
      <div style="text-align:center;position:relative;z-index:1">
        <div style="font-size:5rem;margin-bottom:8px" id="tier-icon-big"></div>
        <div style="font-size:.85rem;opacity:.7">Keep earning to level up!</div>
        <a href="booking.ejs" class="btn btn-white mt-16">Book & Earn </a>
      </div>
    </div>

    <!-- PROGRESS BAR to next tier -->
    <div class="card card-body mb-32" id="tier-progress-card">
      <div class="flex-between mb-12">
        <h3 style="font-size:1rem">Progress to Next Tier</h3>
        <span id="tier-pct-label" style="font-size:.82rem;color:var(--primary);font-weight:700">0%</span>
      </div>
      <div class="progress-bar" style="height:14px;border-radius:10px">
        <div class="progress-fill" id="tier-progress-bar" style="height:100%;border-radius:10px;background:linear-gradient(90deg,var(--primary),var(--primary-light))"></div>
      </div>
      <div class="flex-between mt-8" style="font-size:.75rem;color:var(--gray-500)">
        <span> Bronze (0)</span>
        <span> Silver (100)</span>
        <span> Gold (300)</span>
        <span> Platinum (500)</span>
      </div>
    </div>

    <!-- TIERS -->
    <div class="section-header">
      <div class="tag">Membership Tiers</div>
      <h2>Unlock More Benefits</h2>
      <p>The more you service, the more you earn and the better your perks.</p>
    </div>
    <div class="grid-4 mb-48" id="tiers-grid"></div>

    <!-- REWARDS CATALOGUE -->
    <div class="section-header">
      <div class="tag">Catalogue</div>
      <h2>Redeem Your Points</h2>
      <p>Use your earned points for free services, discounts, and exclusive perks.</p>
    </div>
    <div class="grid-3 mb-48" id="rewards-grid"></div>

    <!-- HOW IT WORKS -->
    <div style="display:grid;grid-template-columns:1fr 360px;gap:40px;align-items:start" class="rewards-howto">
      <div class="card card-body">
        <h3 style="margin-bottom:20px">How to Earn Points</h3>
        <div class="how-step">
          <div class="how-step-num">1</div>
          <div><h4 style="margin-bottom:4px">Book a Service</h4><p style="font-size:.85rem">Every booking earns you 10 base points.</p></div>
        </div>
        <div class="how-step">
          <div class="how-step-num">2</div>
          <div><h4 style="margin-bottom:4px">Complete the Service</h4><p style="font-size:.85rem">Get a bonus of 5 points when your service is marked complete.</p></div>
        </div>
        <div class="how-step">
          <div class="how-step-num">3</div>
          <div><h4 style="margin-bottom:4px">Leave a Review</h4><p style="font-size:.85rem">Leave a verified review and earn 15 extra points.</p></div>
        </div>
        <div class="how-step">
          <div class="how-step-num">4</div>
          <div><h4 style="margin-bottom:4px">Refer a Friend</h4><p style="font-size:.85rem">Each successful referral earns you 50 bonus points.</p></div>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:16px">
        <div class="card card-body" style="background:linear-gradient(135deg,var(--gray-900),#1a0006);color:white">
          <h3 style="margin-bottom:16px;color:white">Points History</h3>
          <div id="points-history"></div>
        </div>
        <div class="card card-body">
          <h3 style="margin-bottom:14px">Terms & Expiry</h3>
          <ul style="display:flex;flex-direction:column;gap:8px;font-size:.83rem;color:var(--gray-600)">
            <li>⏳ Points expire after <strong>12 months</strong> of inactivity.</li>
            <li>🎯 Minimum <strong>50 points</strong> required to redeem.</li>
            <li>🔒 Points cannot be transferred between accounts.</li>
            <li>📋 Redemptions apply to next booking only.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<div id="footer-wrap"></div>

<style>
  @media(max-width:768px){ .rewards-howto{grid-template-columns:1fr!important} }
</style>

<script src="../public/Js/shared.js"></script>
<script src="../public/Js/script.js"></script>
<script>
  const TIERS = [
    { name:'Bronze',   icon:'', min:0,   max:99,  color:'#cd7f32', perks:['10 pts per booking','Basic rewards access'] },
    { name:'Silver',   icon:'', min:100, max:299, color:'silver',  perks:['15 pts per booking','Early booking access','5% discount'] },
    { name:'Gold',     icon:'', min:300, max:499, color:'#ffd700', perks:['20 pts per booking','Priority service','10% discount'] },
    { name:'Platinum', icon:'', min:500, max:Infinity, color:'#b9f2ff', perks:['25 pts per booking','VIP lounge','20% discount','Free annual inspection'] },
  ];

  window.addEventListener('DOMContentLoaded', () => {
    const user   = auth.current() || getById(KEYS.USERS, 'u2');
    const points = user?.points || 0;

    // Update banner
    document.getElementById('points-display').textContent = points;

    const tier = TIERS.find(t => points >= t.min && points <= t.max) || TIERS[0];
    const nextTier = TIERS.find(t => t.min > points);
    document.getElementById('tier-name').textContent = `${tier.icon} ${tier.name} Tier`;
    document.getElementById('tier-icon-big').textContent = tier.icon;

    if (nextTier) {
      const ptsNeeded = nextTier.min - points;
      document.getElementById('pts-to-next').textContent    = ptsNeeded;
      document.getElementById('tier-progress-text').textContent = `${ptsNeeded} pts to ${nextTier.name}`;
      const pct = Math.min(100, Math.round(((points - tier.min) / (nextTier.min - tier.min)) * 100));
      document.getElementById('tier-progress-bar').style.width = pct + '%';
      document.getElementById('tier-pct-label').textContent     = pct + '%';
    } else {
      document.getElementById('pts-to-next').textContent    = 'MAX';
      document.getElementById('tier-progress-text').textContent = 'Maximum tier reached!';
      document.getElementById('tier-progress-bar').style.width  = '100%';
      document.getElementById('tier-pct-label').textContent     = '100%';
    }

    // Tiers grid
    document.getElementById('tiers-grid').innerHTML = TIERS.map(t => {
      const isActive = t.name === tier.name;
      return `
        <div class="tier-card ${isActive ? 'active-tier' : ''}">
          <div class="tier-badge" style="background:${t.color}20">${t.icon}</div>
          <h3 style="margin-bottom:4px">${t.name}</h3>
          <div style="font-size:.78rem;color:var(--gray-500);margin-bottom:14px">${t.min}${t.max !== Infinity ? ''+t.max : '+'} pts</div>
          ${t.perks.map(p => `<div style="font-size:.82rem;padding:5px 0;border-bottom:1px solid var(--gray-100)">${p}</div>`).join('')}
          ${isActive ? '<div class="badge badge-red" style="margin-top:12px">Current Tier ✓</div>' : ''}
        </div>`;
    }).join('');

    // Rewards grid
    document.getElementById('rewards-grid').innerHTML = REWARD_ITEMS.map(r => {
      const canRedeem = points >= r.points;
      return `
        <div class="reward-item ${canRedeem ? '' : 'locked'}" onclick="${canRedeem ? 'redeemReward(\'' + r.id + '\',\'' + r.name + '\',' + r.points + ')' : ''}">
          <div class="reward-icon">${r.icon}</div>
          <h3 style="margin-bottom:6px;font-size:1rem">${r.name}</h3>
          <div style="color:var(--primary);font-weight:700;margin-bottom:4px">🪙 ${r.points} points</div>
          <div style="font-size:.78rem;color:var(--gray-500)">Worth ~$${r.value}</div>
          ${canRedeem
            ? '<div class="btn btn-primary btn-sm" style="margin-top:14px;display:inline-flex">Redeem →</div>'
            : `<div style="font-size:.75rem;color:var(--gray-400);margin-top:10px"> Need ${r.points - points} more pts</div>`}
        </div>`;
    }).join('');

    // Points history
    const userBookings = user ? bookings.forUser(user.id) : [];
    const history = [
      ...userBookings.map(b => ({ date: b.createdAt, icon:'', label:`Booking created`, pts:10 })),
      { date:'2026-03-15', icon:'🤝', label:'Referral bonus', pts:50 },
      { date:'2026-02-20', icon:'', label:'Review submitted', pts:15 },
    ].sort((a,b) => new Date(b.date) - new Date(a.date)).slice(0,5);
    document.getElementById('points-history').innerHTML = history.length
      ? history.map(h => `<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.08)"><div><div style="font-size:.82rem">${h.icon} ${h.label}</div><div style="font-size:.72rem;color:rgba(255,255,255,.4)">${formatDate(h.date)}</div></div><span style="color:var(--primary-light);font-weight:700">+${h.pts}</span></div>`).join('')
      : '<p style="color:rgba(255,255,255,.4);font-size:.82rem">No history yet. Book your first service!</p>';
  });

  function redeemReward(id, name, points) {
    const user = auth.current();
    if (!user) { showToast('Please login to redeem rewards', 'warning'); return; }
    if (user.points < points) { showToast('Not enough points', 'error'); return; }
    auth.updateCurrent({ points: user.points - points });
    showToast(` "${name}" redeemed! -${points} points. Applies to your next booking.`, 'success');
    setTimeout(() => location.reload(), 1500);
  }
</script>
</body>
</html>

